APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel_project1
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Produção: MAIL_MAILER=resend + domínio verificado em resend.com/domains.
# RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"

# --- Loja (config/shop.php) ---------------------------------------------
# Moeda usada no Stripe e formatação de preços exibida ao usuário.
SHOP_CURRENCY=brl
SHOP_CURRENCY_SYMBOL="R$"
SHOP_CURRENCY_DECIMAL_SEPARATOR=","
SHOP_CURRENCY_THOUSANDS_SEPARATOR="."

# Minutos que um pedido "pending" tem para ser pago antes de expirar.
# O Stripe exige no mínimo 30 min para a Checkout Session, então valores
# menores que 30 aqui não reduzem o prazo real do lado do Stripe.
CHECKOUT_EXPIRATION_MINUTES=30

# Upload de imagens (produto e foto de perfil).
IMAGE_MAX_KB=2048
IMAGE_MIMES=jpeg,png,webp

# Paginação / tamanhos de listagem.
PAGINATE_ORDERS=10
PAGINATE_SEARCH=20
PAGINATE_TAG_PRODUCTS=20
HOME_RECENT_POOL=200
HOME_PRODUCTS_PER_CATEGORY=15
PROFILE_RECENT_RATINGS=5

# E-mail de contato exibido no rodapé.
SUPPORT_EMAIL=renato.deacaldas@gmail.com

# Rate limiting (requisições por minuto).
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_SEARCH=30
RATE_LIMIT_CART=60
RATE_LIMIT_CHECKOUT=15
RATE_LIMIT_WITHDRAW=5
RATE_LIMIT_RATINGS=10
RATE_LIMIT_LISTINGS=20
RATE_LIMIT_PROFILE=20
RATE_LIMIT_LOGIN=5
RATE_LIMIT_TWO_FACTOR=5
RATE_LIMIT_REGISTER=5
RATE_LIMIT_PASSWORD_EMAIL=5
RATE_LIMIT_PASSWORD_UPDATE=10
